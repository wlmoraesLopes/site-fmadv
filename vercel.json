{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/profissionais/fernanda", "destination": "/profissionais", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}